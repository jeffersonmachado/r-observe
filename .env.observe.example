# ─── R-Observe AI Ops — Variáveis de Ambiente ────────────────────────────────
# Copie para .env.observe e preencha os valores obrigatórios (marcados com *)
# NUNCA commite .env.observe com segredos reais.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PRODUTO ─────────────────────────────────────────────────────────────────
R_OBSERVE_ENABLED=true
R_OBSERVE_MODE=compose
R_OBSERVE_TENANT_MODE=multi

# URL pública do stack (usado em logs, emails e links gerados pela API)
# Desenvolvimento local:
R_OBSERVE_PUBLIC_URL=http://localhost:3080
# Produção (após deploy em 10.10.2.30 com subdomínio via secure-httpd):
# R_OBSERVE_PUBLIC_URL=https://r-observe.results.com.br

# ─── TIMEZONE ────────────────────────────────────────────────────────────────
TZ=America/Sao_Paulo
NODE_ENV=production

# ─── PROXY ───────────────────────────────────────────────────────────────────
OBSERVE_HTTP_PORT=3080
OBSERVE_PROXY_BIND_IP=0.0.0.0

# ─── PORTAS / URLs (dev local vs Docker compose) ─────────────────────────────
# No dev local (npm run dev), servicos rodam no host com portas alternativas.
# No Docker compose, usam portas padrao e nomes de container.

# Dev local (host):
OBSERVE_API_PORT=3009
OBSERVE_DISCOVERY_PORT=3010
OBSERVE_AI_PORT=3011
VITE_DEV_PORT=5177
AI_SERVICE_URL=http://127.0.0.1:3011
DISCOVERY_SERVICE_URL=http://127.0.0.1:3010

# Docker compose (descomente para producao):
# OBSERVE_API_PORT=3000
# OBSERVE_DISCOVERY_PORT=3010
# OBSERVE_AI_PORT=3000
# AI_SERVICE_URL=http://r-observe-ai:3000
# DISCOVERY_SERVICE_URL=http://r-observe-discovery:3010

# ─── API ─────────────────────────────────────────────────────────────────────
R_OBSERVE_API_BASE_PATH=/observe/api
# CORS: allowlist separada por vírgula; vazio desabilita cross-origin.
# Sessões com cookie são aceitas somente para origens explicitamente listadas.
OBSERVE_CORS_ORIGINS=
# Proteção contra força bruta: tentativas por combinação usuário+IP.
OBSERVE_LOGIN_MAX_ATTEMPTS=5
OBSERVE_LOGIN_WINDOW_SECONDS=900
OBSERVE_LOGIN_LOCK_SECONDS=900
# Limites distribuídos no Redis, por cliente e janela.
OBSERVE_RATE_LIMIT_WINDOW_MS=60000
OBSERVE_RATE_LIMIT_API_MAX=300
OBSERVE_RATE_LIMIT_EVENTS_MAX=100

# ─── AUTENTICAÇÃO INTERNA ENTRE SERVIÇOS (JWT assimétrico RS256) ─────────────
# Não há segredo compartilhado. As chaves são montadas via docker secrets
# (ver bloco `secrets:` no docker-compose.observe.yml) a partir de:
#   ./secrets/jwt_{api,worker,agent,discovery,automation}_{private,public}.pem
# Gere o par com:
#   mkdir -p secrets && chmod 700 secrets
#   scripts/observe/jwt-keys.sh init
# Validade dos tokens internos (opcional, padrão 5m):
# JWT_EXPIRY=5m
# Emissor compartilhado; audience e scopes são fixados por serviço no Compose:
# JWT_ISSUER=r-observe
# Duração máxima aceita pelos verificadores (scripts operacionais usam até 30m):
# JWT_MAX_LIFETIME=30m
# JWT_CLOCK_TOLERANCE_SECONDS=5
#
# ─── SEGREDOS (OBRIGATÓRIO - gerar com: openssl rand -hex 32) ────────────────
# * Secret para validação de webhooks
OBSERVE_WEBHOOK_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ─── BANCO DE DADOS (PostgreSQL) ─────────────────────────────────────────────
# * Senha do banco R-Observe
OBSERVE_DB_NAME=observedb
OBSERVE_DB_USER=observe
OBSERVE_DB_PASSWORD=CHANGE_ME_strong_password_here
# Role sem privilégios administrativos usada em runtime por API/Worker/Discovery.
OBSERVE_DB_APP_USER=observe_app
# Em produção, use uma senha diferente de OBSERVE_DB_PASSWORD.
OBSERVE_DB_APP_PASSWORD=CHANGE_ME_distinct_runtime_password_here
OBSERVE_DB_EXPORTER_USER=observe_exporter
OBSERVE_DB_EXPORTER_PASSWORD=CHANGE_ME_distinct_exporter_password_here

# ─── BANCO DE DADOS (IcingaDB - separado no mesmo PostgreSQL) ────────────────
# Necessário somente com profile observe-icinga
ICINGADB_DB_NAME=icingadb
ICINGADB_DB_USER=icingadb
ICINGADB_DB_PASSWORD=CHANGE_ME_strong_password_here

# ─── REDIS ───────────────────────────────────────────────────────────────────
# Senha do Redis (vazio = sem autenticação — não recomendado em prod)
OBSERVE_REDIS_PASSWORD=CHANGE_ME_redis_password

# ─── IA ──────────────────────────────────────────────────────────────────────
R_OBSERVE_AI_ENABLED=true
# Providers suportados: openai | anthropic | deepseek | mock
R_OBSERVE_AI_PROVIDER=openai
R_OBSERVE_AI_MODEL=gpt-4o-mini
R_OBSERVE_AI_TIMEOUT_MS=30000

# API Keys (somente o provider selecionado precisa ser preenchido)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ─── DISCOVERY (dev local) ───────────────────────────────────────────────────
# Em dev local, scan e listeners passivos ficam desligados por seguranca.
# No Docker compose, o proprio docker-compose.observe.yml define defaults.
DISCOVERY_SCAN_QUEUE_ENABLED=false
DISCOVERY_PASSIVE_MAX_ASSETS=5000
DISCOVERY_PASSIVE_MAX_PACKET_BYTES=8192
DISCOVERY_PASSIVE_RATE_PER_MINUTE=600
DISCOVERY_RETENTION_ENABLED=true
DISCOVERY_RETENTION_METRICS_DAYS=30
DISCOVERY_RETENTION_HISTORY_DAYS=90
DISCOVERY_RETENTION_FINDINGS_DAYS=90
DISCOVERY_RETENTION_CHANGES_DAYS=180
DISCOVERY_RETENTION_BATCH_SIZE=5000
DISCOVERY_PASSIVE_LISTENERS_ENABLED=false
DISCOVERY_DOCKER_ENABLED=false

# Gateway e IPs locais do host real — essencial para container Docker
# detectar gateway e localhost corretamente (sem network_mode:host)
DISCOVERY_HOST_GATEWAY=192.168.0.1
DISCOVERY_HOST_LOCAL_IPS=192.168.0.50

# ─── REMEDIAÇÃO COM SUPERVISÃO POR SCORE ─────────────────────────────────────
REMEDIATION_ENABLED=true
# Score mínimo (0.0–1.0) para execução automática sem aprovação humana
# >= 0.85: executa direto | < 0.85: fica em pending_approval para revisão
REMEDIATION_AUTO_THRESHOLD=0.85
# Severidade máxima para auto-execução (warning = não executa incidentes critical)
REMEDIATION_MAX_AUTO_SEVERITY=warning
# Containers Docker que podem ser reiniciados automaticamente (lista separada por vírgula)
# Deixar vazio desabilita docker:restart e docker:start por segurança
REMEDIATION_ALLOWED_CONTAINERS=

# ─── ICINGA ──────────────────────────────────────────────────────────────────
# URL interna da API Icinga2 (usada pela r-observe-api)
ICINGA_API_URL=https://observe-icinga2:5665
# * Usuário e senha da API Icinga2
ICINGA_API_USER=icingaweb2
ICINGA_API_PASSWORD=CHANGE_ME_icinga_api_password
# Validação TLS é estrita por padrão. Em produção, mantenha true e informe a CA
# confiável dentro do contêiner quando o certificado não vier de uma CA pública.
ICINGA_API_TLS_REJECT_UNAUTHORIZED=true
ICINGA_API_CA_FILE=
# Credenciais do IcingaWeb2
ICINGAWEB_ADMIN_USER=admin
ICINGAWEB_ADMIN_PASS=CHANGE_ME_icingaweb_admin_pass
# URL pública do IcingaWeb2 (para links em notificações)
ICINGA_WEB_URL=http://localhost:3080/icinga

# ─── PROMETHEUS / LOKI / GRAFANA ─────────────────────────────────────────────
# Retenção do Prometheus
PROMETHEUS_RETENTION=15d
# * Senha do admin do Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# URLs internas (usadas por scripts e pelo proxy)
PROMETHEUS_URL=http://observe-prometheus:9090
LOKI_URL=http://observe-loki:3100
GRAFANA_URL=http://observe-grafana:3000

# ─── AGENTE ──────────────────────────────────────────────────────────────────
OBSERVE_AGENT_ID=local-agent-01
# Endereço do host Docker monitorado pelo agente.
OBSERVE_AGENT_HOST_ADDRESS=10.10.2.30
# Projetos Docker Compose que o agente registra no inventário.
OBSERVE_DOCKER_PROJECTS=infra,infra-httpd,infra-mail,dns-consolidated,edge-sni
# Containers esperados como one-shot ou fora de alerta.
OBSERVE_DOCKER_IGNORE_CONTAINERS=results-mail-certs-bootstrap
# URL da API usada pelo agente (padrão: rede interna)
OBSERVE_AGENT_API_URL=http://r-observe-api:3000
# Intervalo de checks em ms (padrão: 60s)
OBSERVE_AGENT_CHECK_INTERVAL_MS=60000
# Threshold de disco para alerta (%)
OBSERVE_AGENT_DISK_WARN=80

# ─── AGENTE: checks HTTP externos (label=url, vírgula-separados) ─────────────
# O agente verifica cada endpoint a cada ciclo e envia evento em caso de falha.
OBSERVE_HTTP_CHECKS=secure-httpd=https://10.10.2.30,webmail=https://10.10.2.30/webmail,observe-proxy=http://r-observe-proxy:80/observe/api/health,grafana=http://r-observe-grafana:3000/api/health,prometheus=http://r-observe-prometheus:9090/prometheus/-/healthy,rspamd=http://10.10.2.30:11334/stat

# ─── AGENTE: checks TCP externos (label=host:port, vírgula-separados) ────────
# Verifica conectividade TCP com serviços não-HTTP (SMTP, IMAP, DB, DNS, etc.)
OBSERVE_TCP_CHECKS=postfix-mx1=10.10.2.3:25,postfix-mx2=10.10.2.23:25,dovecot-imaps=10.10.2.3:993,smtp-submission-mx1=10.10.2.3:587,mariadb=10.10.2.99:3306,ns1-dns=10.10.2.1:53,ns2-dns=10.10.2.20:53

# ─── AGENTE: hosts estáticos/externos (JSON array) ───────────────────────────
# Registra hosts externos (fora do Docker local) no inventário da API.
# Campos: name (obrigatório), address (obrigatório), display_name, vars (objeto livre)
OBSERVE_STATIC_HOSTS=[{"name":"mariadb","address":"10.10.2.99","display_name":"MariaDB 10.10.2.99","vars":{"role":"database","port":3306}},{"name":"postfix-mx1","address":"10.10.2.3","display_name":"Postfix MX1","vars":{"role":"mail-mx","smtp_port":25,"imaps_port":993}},{"name":"postfix-mx2","address":"10.10.2.23","display_name":"Postfix MX2","vars":{"role":"mail-mx","smtp_port":25}},{"name":"ns1","address":"10.10.2.1","display_name":"NS1 (dnsdist)","vars":{"role":"dns"}},{"name":"ns2","address":"10.10.2.20","display_name":"NS2","vars":{"role":"dns"}}]

# ─── LOGS ────────────────────────────────────────────────────────────────────
OBSERVE_LOG_LEVEL=info
OBSERVE_LOG_MAX_SIZE=50m
OBSERVE_LOG_MAX_FILE=5

# ─── WHATSAPP QR (canal alternativo não-oficial, whatsapp-web.js) ───────────
# Habilita o bridge QR no worker (sem isto, o serviço nem sobe).
# A conexão em si (QR Code) é habilitada/pareada pela UI em /observe/settings → WhatsApp.
WHATSAPP_QR_ENABLED=false
# Diretório de sessão do whatsapp-web.js (volume observe-whatsapp-auth no compose)
WHATSAPP_QR_AUTH_PATH=/var/lib/r-observe/whatsapp-auth
# Versão do WA Web pinada pelo canal QR (escape hatch; default: sem pin).
# Vazio/latest = WA Web mais recente. Pin só funciona enquanto os assets do build
# estiverem no CDN do WhatsApp e exige <versao>.html no cache local (wa-web/ do pacote).
#WHATSAPP_QR_WEB_VERSION=

# User-Agent do Chrome do canal QR.
# default "auto" (vazio): detecta a versão real do binário do Chrome e monta um
# UA coerente — NECESSÁRIO: o spoof nativo da lib (Chrome 101/macOS 10.14, 2022)
# é morto com LOGOUT pela Meta minutos após o pareamento (verificado ago/2026).
# "default" = spoof nativo da lib (só p/ comparar comportamento); "false" = UA
# genuíno do binário sem spoof; qualquer outra string = usada como está.
#WHATSAPP_QR_USER_AGENT=

# Nome do aparelho sugerido no pareamento QR (default: "R-Observe"). O WhatsApp
# não devolve à sessão o nome exibido em "Aparelhos conectados" — fixar um nome
# é a única forma de a sessão ser auto-identificável. Só vale para NOVOS
# pareamentos (sessões já pareadas mantêm o nome registrado na Meta no scan).
#WHATSAPP_QR_DEVICE_NAME=
