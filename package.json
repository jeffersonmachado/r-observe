{
  "name": "r-observe-stack",
  "private": true,
  "version": "1.0.0",
  "description": "Stack operacional do R-Observe",
  "scripts": {
    "dev": "sh -c 'set -a; . ./.env.observe; set +a; bash ./scripts/observe/dev-local-up.sh; DB_HOST=127.0.0.1 DB_PORT=5432 DB_NAME=${OBSERVE_DB_NAME:-observedb} DB_USER=${OBSERVE_DB_USER:-observe} DB_PASSWORD=${OBSERVE_DB_PASSWORD} REDIS_URL=redis://:${OBSERVE_REDIS_PASSWORD:-}@127.0.0.1:6379 JWT_SECRET=${JWT_SECRET:-} PORT=3009 VITE_DEV_ORIGIN=http://127.0.0.1:5177 npm --prefix ./r-observe run dev'",
    "observe:up": "docker compose -f docker-compose.observe.yml --env-file .env.observe --profile observe-core --profile observe-ai --profile observe-monitoring --profile r-observe-proxy up -d",
    "observe:up:core": "docker compose -f docker-compose.observe.yml --env-file .env.observe --profile observe-core up -d",
    "observe:up:full": "docker compose -f docker-compose.observe.yml --env-file .env.observe --profile observe-core --profile observe-ai --profile observe-agent --profile observe-monitoring --profile observe-icinga --profile r-observe-proxy up -d",
    "observe:down": "docker compose -f docker-compose.observe.yml --env-file .env.observe down",
    "observe:down:volumes": "docker compose -f docker-compose.observe.yml --env-file .env.observe down -v",
    "observe:build": "docker compose -f docker-compose.observe.yml --env-file .env.observe build",
    "observe:logs": "docker compose -f docker-compose.observe.yml --env-file .env.observe logs -f --tail=100",
    "observe:ps": "docker compose -f docker-compose.observe.yml --env-file .env.observe ps",
    "observe:health": "bash ./scripts/observe/healthcheck.sh",
    "observe:validate": "bash ./scripts/observe/validate-compose.sh",
    "observe:smoke": "bash ./scripts/observe/smoke-observe-stack.sh",
    "observe:smoke:icinga": "bash ./scripts/observe/smoke-icinga.sh",
    "observe:deploy": "bash ./scripts/observe/deploy.sh",
    "observe:deploy:remote": "bash ./scripts/observe/deploy.sh --host ${DEPLOY_HOST:-10.10.2.30}",
    "observe:deploy:prod": "bash ./scripts/observe/deploy-prod.sh",
    "observe:deploy:remote2": "bash ./scripts/observe/deploy-remote.sh",
    "observe:deploy:remote2:discovery": "bash ./scripts/observe/deploy-remote.sh --service discovery",
    "observe:deploy:remote2:api": "bash ./scripts/observe/deploy-remote.sh --service api",
    "observe:deploy:remote2:no-build": "bash ./scripts/observe/deploy-remote.sh --no-build",
    "observe:deploy:remote2:skip-smoke": "bash ./scripts/observe/deploy-remote.sh --skip-smoke",
    "observe:security": "bash ./scripts/observe/check-docker-safety.sh",
    "observe:release-check": "npm run observe:validate && npm run observe:security",
    "observe:migrate": "node r-observe/api/src/migrate.js",
    "observe:migrate:status": "node -e \"const {runMigrations}=require('./r-observe/api/src/migrate');\" 2>/dev/null || echo 'use: npm run observe:migrate'",
    "observe:discover": "bash ./scripts/observe/discover-hosts.sh",
    "observe:discover:r-observe": "bash ./scripts/observe/discover-hosts.sh --mode r-observe",
    "observe:discover:sd": "bash ./scripts/observe/discover-hosts.sh --mode prometheus-sd",
    "observe:discover:all": "bash ./scripts/observe/discover-hosts.sh --mode all",
    "observe:discover:engine:scan": "curl -sS -X POST http://localhost:3080/observe/discovery/api/discovery/scan -H 'Content-Type: application/json' -d '{\"profile\":\"safe\",\"trigger\":\"npm-script\"}'",
    "observe:discover:engine:runs": "curl -sS http://localhost:3080/observe/discovery/api/discovery/runs",
    "observe:discover:engine:assets": "curl -sS http://localhost:3080/observe/discovery/api/discovery/assets",
    "observe:hosts:list": "bash ./scripts/observe/discover-hosts.sh --list",
    "observe:token:show": "bash ./scripts/observe/token.sh show",
    "observe:token:copy": "bash ./scripts/observe/token.sh copy",
    "observe:token:verify": "bash ./scripts/observe/token.sh verify",
    "observe:token:rotate": "bash ./scripts/observe/token.sh rotate",
    "observe:token:recover": "bash ./scripts/observe/token.sh recover",
    "discovery:test": "npm --prefix ./r-observe/discovery test",
    "discovery:lint": "bash ./scripts/discovery/discovery-lint.sh",
    "discovery:smoke": "bash ./scripts/discovery/discovery-smoke.sh",
    "discovery:smoke:enterprise": "bash ./scripts/discovery/discovery-enterprise-smoke.sh",
    "discovery:audit": "bash ./scripts/discovery/discovery-audit.sh",
    "discovery:integration": "bash ./scripts/discovery/discovery-integration.sh",
    "discovery:gate": "bash ./scripts/discovery/discovery-gate.sh",
    "dist:clean:release": "rm -rf dist && mkdir -p dist",
    "zip": "bash ./scripts/package/zip-release.sh --clean-dist --output dist/infra.zip",
    "zip:release": "bash ./scripts/package/zip-release.sh --output dist/infra-release.zip",
    "zip:validate": "bash ./scripts/package/validate-zip.sh dist/infra.zip",
    "zip:validate:release": "bash ./scripts/package/validate-zip.sh dist/infra-release.zip",
    "release:validate:enterprise": "node ./scripts/release/validate-enterprise-package.js --zip dist/infra.zip --runtime && node ./scripts/release/validate-enterprise-package.js --zip dist/infra-release.zip --runtime && bash ./scripts/package/validate-extracted-runtime.sh dist/infra.zip && bash ./scripts/package/validate-extracted-runtime.sh dist/infra-release.zip",
    "release:validate:runtime": "node ./scripts/release/validate-enterprise-package.js --zip dist/infra.zip --runtime",
    "zip:deploy": "mkdir -p dist && rm -f dist/infra-deploy.zip && git ls-files -z -- . ':(exclude)docs/**' ':(exclude)tests/**' ':(exclude)test-results/**' ':(exclude).agents/**' ':(exclude).claude/**' ':(exclude).codex/**' ':(exclude)dist/**' | tr \"\\\\0\" '\\n' | zip -q -9 dist/infra-deploy.zip -@",
    "release:audit": "bash ./scripts/package/release-audit.sh",
    "release:smoke": "bash ./scripts/package/release-smoke.sh",
    "release:gate": "bash ./scripts/package/release-gate.sh",
    "release:ci:hardened": "bash ./scripts/package/release-ci-hardened.sh",
    "release:loop": "bash ./scripts/package/release-enterprise-loop.sh",
    "test:e2e": "npx playwright test --config=playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
