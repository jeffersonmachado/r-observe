# Copie para .env.dev e preencha com os valores do seu ambiente.
# O nodemon carrega este arquivo automaticamente ao rodar npm run dev.
#
# Para usar as credenciais de produção via SSH tunnel:
#   ssh -L 5432:observe-postgres:5432 -L 6379:observe-redis:6379 root@10.10.2.30

NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=observe
DB_USER=observe
DB_PASSWORD=TROQUE_AQUI

# Redis
REDIS_URL=redis://localhost:6379

# Proteção de login (fallback em memória se Redis estiver indisponível)
OBSERVE_LOGIN_MAX_ATTEMPTS=5
OBSERVE_LOGIN_WINDOW_SECONDS=900
OBSERVE_LOGIN_LOCK_SECONDS=900
OBSERVE_RATE_LIMIT_WINDOW_MS=60000
OBSERVE_RATE_LIMIT_API_MAX=300
OBSERVE_RATE_LIMIT_EVENTS_MAX=100

# JWT interno RS256
# Exemplo para API local; ajuste a identidade conforme o processo executado.
JWT_PRIVATE_KEY_FILE=../secrets/jwt_api_private.pem
JWT_KEY_ID=api
JWT_PUBLIC_KEY_FILES=agent=../secrets/jwt_agent_public.pem,automation=../secrets/jwt_automation_public.pem
JWT_ISSUER=r-observe
JWT_MAX_LIFETIME=30m
JWT_CLOCK_TOLERANCE_SECONDS=5
# Em execução local, configure por processo: api/api:access,
# discovery/discovery:access ou ai/ai:access.
# JWT_AUDIENCE=api
# JWT_REQUIRED_SCOPES=api:access

# Serviços (usar localhost em dev)
AI_SERVICE_URL=http://localhost:3001
DISCOVERY_SERVICE_URL=http://localhost:3010
AI_ENABLED=true

# Porta dos serviços
PORT=3000

# Log
LOG_LEVEL=debug
